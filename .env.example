# Copy to .env (optional)
# Use the in-browser fake backend instead of PHP:
# VITE_USE_MOCK=true

# Where Apache serves the API (defaults shown)
# BACKEND_URL=http://localhost
# BACKEND_PATH=/plugguard-api

# Hostnames other than localhost that may open the dev server (a Cloudflare tunnel, a LAN name...), comma separated.
# ALLOWED_HOSTS=my-tunnel.trycloudflare.com
